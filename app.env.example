# Application settings, loaded by compose via env_file.
# Copy to "<COMPOSE_PROJECT_NAME>-app.env" (e.g. github-backup-app.env).
# Values are taken literally: no ${VAR} interpolation, no inline comments.

# --- Required -------------------------------------------------------------
GH_ACCOUNT=your-github-user-or-organization
# Set to true when GH_ACCOUNT is an organization.
GH_ORGANIZATION=false

TZ=UTC

# --- What to back up ------------------------------------------------------
INCLUDE_PRIVATE=true
INCLUDE_FORKS=true
# Extra flags passed verbatim (word-split) to github-backup. Leave empty if unsure.
GH_EXTRA_ARGS=

# --- Schedule (all values in seconds) -------------------------------------
# Pause between runs. 21600 = 6 hours.
BACKUP_INTERVAL=21600
# A non-incremental refresh is done when the last one is older than this.
# 604800 = 7 days.
FULL_INTERVAL=604800

# Optional success-only HTTP GET after a successful backup.
# Leave empty to disable.
KEEPALIVE_URL=
KEEPALIVE_TIMEOUT=10

# --- Verification ---------------------------------------------------------
# Seconds between integrity verifications (run after a successful backup).
# 604800 = 7 days. 0 = verify after every successful backup.
VERIFY_INTERVAL=604800
# Re-hash all Git LFS objects during verification. Set to false to skip when
# the LFS store is very large.
VERIFY_LFS=true

# Optional success-only HTTP GET after ALL verification checks pass.
# Leave empty to disable.
VERIFY_KEEPALIVE_URL=
VERIFY_KEEPALIVE_TIMEOUT=10
