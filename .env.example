# Used by docker compose itself (interpolation in compose.yaml).
# Application settings are in <COMPOSE_PROJECT_NAME>-app.env (see app.env.example).

# Selects the application env file: ${COMPOSE_PROJECT_NAME}-app.env
COMPOSE_PROJECT_NAME=github-backup
# Absolute host path mounted as /data (backups and status/ markers).
BACKUP_HOST_PATH=/absolute/path/to/backup/storage
# Image tag of python-github-backup. Pin a release for reproducible behaviour.
BACKUP_IMAGE_TAG=latest
